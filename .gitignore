# Dependencies
# No trailing slash: that form matches directories only, and a symlinked
# node_modules — how a worktree usually borrows the parent's install — is not
# a directory, so it slipped past and got committed.
node_modules
.pnp/
.pnp.js

# Build output
dist/
build/
.tmp-example/
*.tsbuildinfo

# Python (python/ — the OSDK runtime + generator)
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Test / coverage
coverage/
.nyc_output/
test-results/
*.lcov

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
!.env.example
*.local

# Local CLI state (BKN tokens/config — never commit)
.bkn/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Package manager artifacts
.npm/
*.tgz

.cursor/

# Claude Code local worktrees
.claude/
